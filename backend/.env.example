# Copy this file to .env and fill in your own values.
# .env is NEVER committed (it is in .gitignore).

# The AI layer (optional): auto or api = with your own Anthropic API key below; off = search engine only.
# In the app you can also set the key in Settings -> AI with your own key.
PARTSFINDER_AI_BACKEND=auto

# Your own Anthropic API key (console.anthropic.com). Empty = everything works without AI.
ANTHROPIC_API_KEY=

# Claude model for the AI layer (haiku = cheap, sonnet = smarter but ~20x more expensive)
PARTSFINDER_CLAUDE_MODEL=claude-haiku-5-5

# Where the database lives (default: backend/partsfinder.db)
# PARTSFINDER_DB_PATH=

# Where the CAD files live (default: data/)
# PARTSFINDER_DATA_DIR=

# Embedding model (local, multilingual) and its vector size
PARTSFINDER_EMBEDDING_MODEL=intfloat/multilingual-e5-small
PARTSFINDER_EMBEDDING_DIM=384

# Maximum estimated cost per test round in dollars (safety cap, API key only)
PARTSFINDER_MAX_SPEND_USD=0.50

# API keys (optional, recommended once the API runs on more than this pc).
# Format: key=company, several separated by commas; '*' = admin (ingest and company list).
# Choose long random keys and NEVER put them in git.
# PARTSFINDER_API_KEYS=long-key-for-company-a=company_a,long-admin-key=*
